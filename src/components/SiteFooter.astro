---
import { navigation } from '../config/site';
import TipLink from './TipLink.astro';
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner grid gap-6 py-12 text-center md:grid-cols-3 md:items-center">
    <div class="md:text-left">
      <p class="text-xs text-muted-foreground">
        Made in Toronto <span role="img" aria-label="Canadian flag">🇨🇦</span>
      </p>
    </div>

    <div class="flex justify-center">
      <TipLink />
    </div>

    <nav aria-label="Footer navigation" class="md:justify-self-end">
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 md:justify-end">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
