---
interface RoadmapItem {
  tag: string;
  title: string;
  icon: string;
}

const items: RoadmapItem[] = [
  {
    tag: 'Video',
    title: 'Walkthrough videos showing the skills in action',
    icon: '<polygon points="7 4 20 12 7 20 7 4"></polygon>',
  },
  {
    tag: 'Template',
    title: 'The Notion Project Workbook template used by the skills',
    icon: '<rect x="5" y="3" width="14" height="18" rx="1.5"></rect><line x1="8.5" y1="8" x2="15.5" y2="8"></line><line x1="8.5" y1="12" x2="15.5" y2="12"></line><line x1="8.5" y1="16" x2="12.5" y2="16"></line>',
  },
  {
    tag: 'Evals',
    title: 'Evaluations, or "evals," to check quality of the outputs',
    icon: '<path d="M9 12.5 11 15l4.5-6"></path><circle cx="12" cy="12" r="9"></circle>',
  },
  {
    tag: 'Telemetry',
    title: 'Skills for project telemetry',
    icon: '<polyline points="4 15 9 9 13 13 20 5"></polyline><polyline points="14 5 20 5 20 11"></polyline>',
  },
  {
    tag: 'Closure',
    title: 'Skills for project closure',
    icon: '<path d="M6 21V4"></path><path d="M6 4h12l-3.5 4L18 12H6"></path>',
  },
];
---

<ol class="roadmap">
  {
    items.map((item) => (
      <li class="roadmap__item">
        <span class="roadmap__node-col">
          <span class="roadmap__stem" aria-hidden="true" />
          <span class="roadmap__node" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={item.icon} />
          </span>
        </span>
        <span class="roadmap__body">
          <span class="roadmap__tag">{item.tag}</span>
          <span class="roadmap__title">{item.title}</span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .roadmap {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.15rem;
    padding-bottom: clamp(1.75rem, 4vw, 2.25rem);
  }

  .roadmap__item:last-child {
    padding-bottom: 0;
  }

  .roadmap__item:last-child .roadmap__stem {
    display: none;
  }

  .roadmap__node-col {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .roadmap__stem {
    position: absolute;
    top: 2.75rem;
    bottom: -0.25rem;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--border);
  }

  .roadmap__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--card, var(--background));
    color: var(--accent);
  }

  .roadmap__node :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .roadmap__body {
    padding-top: 0.35rem;
  }

  .roadmap__tag {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .roadmap__title {
    display: block;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-wrap: pretty;
  }
</style>
