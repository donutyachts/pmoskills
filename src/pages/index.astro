---
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkillCard from '../components/SkillCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { formatStage, getOrderedStages } from '../lib/stages';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const stages = getOrderedStages(skills);
const stageCounts = stages.map((stage) => ({
  name: stage,
  count: skills.filter((s) => s.data.stage === stage).length,
}));
---

<BaseLayout>
  <SiteHeader />
  <main id="content" class="outer">
    <div class="inner">
      <h1 class="sr-only">{siteConfig.name} — {siteConfig.tagline}</h1>

      <div class="grid gap-[var(--space-section)] pt-10 md:pt-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12">
        <section aria-labelledby="more-skills">
          <h2 id="more-skills" class="section-title">The sequence and the skills</h2>

          <div class="feed">
            {skills.map((skill) => <SkillCard skill={skill} stages={stages} />)}
          </div>

          <a href="/skills/" class="btn btn-outline btn-block mt-16">
            Browse all skills, grouped by stage
          </a>
        </section>

        <aside class="sidebar">
          <section aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-title">About</h2>
            <p class="text-lg font-semibold tracking-tight">{siteConfig.name}</p>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">
              {siteConfig.about}
            </p>
          </section>

          <section aria-labelledby="stages-heading">
            <h2 id="stages-heading" class="section-title">Stages</h2>
            <ul class="grid gap-4">
              {
                stageCounts.map((stage) => (
                  <li>
                    <a
                      href={`/skills/#${stage.name.toLowerCase().replace(/\s+/g, '-')}`}
                      class="link-title flex items-center justify-between gap-3"
                    >
                      <span class="link-title__text text-base font-semibold tracking-tight">
                        {formatStage(stage.name, stages)}
                      </span>
                      <span class="pill shrink-0">
                        {stage.count} {stage.count === 1 ? 'skill' : 'skills'}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
