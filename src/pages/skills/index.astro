---
import { getCollection } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SkillCard from '../../components/SkillCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatStage, getOrderedStages } from '../../lib/stages';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const stages = getOrderedStages(skills);
const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout title="Skills" description="All skills, grouped by stage.">
  <SiteHeader />
  <main id="content" class="outer">
    <div class="inner">
      <header class="canvas pagehead">
        <p class="eyebrow">{skills.length} skills · {stages.length} stages</p>
        <h1 class="pagehead-title">Skills</h1>
        <p class="pagehead-description">
          Grouped by the stage of a project they belong to, in the order they're typically used.
        </p>
      </header>

      <div class="canvas grid gap-[var(--space-section)] pb-[var(--space-section)]">
        {
          stages.map((stage) => (
            <section aria-labelledby={slugify(stage)}>
              <h2 id={slugify(stage)} class="section-title">
                {formatStage(stage, stages)}
              </h2>
              <div class="feed">
                {skills
                  .filter((s) => s.data.stage === stage)
                  .map((skill) => (
                    <SkillCard skill={skill} variant="compact" headingLevel="h3" stages={stages} />
                  ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
