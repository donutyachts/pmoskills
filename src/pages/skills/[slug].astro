---
import { getCollection } from 'astro:content';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SkillCard from '../../components/SkillCard.astro';
import StageProgress from '../../components/StageProgress.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatStage, getOrderedStages } from '../../lib/stages';
import { readingLabel } from '../../lib/reading';

const REPO_URL = 'https://github.com/donutyachts/pmoskills';

export async function getStaticPaths() {
  const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
  const stages = getOrderedStages(skills);
  return skills.map((skill) => ({
    params: { slug: skill.slug },
    props: { skill, stages, allSkills: skills },
  }));
}

const { skill, stages, allSkills } = Astro.props;
const { Content } = await skill.render();

const relatedSkills = skill.data.related
  .map((slug) => allSkills.find((s) => s.slug === slug))
  .filter((s) => s !== undefined);

const currentPosition = allSkills.findIndex((s) => s.slug === skill.slug);
const previousSkill = currentPosition > 0 ? allSkills[currentPosition - 1] : undefined;
const nextSkill =
  currentPosition < allSkills.length - 1 ? allSkills[currentPosition + 1] : undefined;

const sourceUrl = `${REPO_URL}/blob/main/${skill.data.sourceFile}`;
---

<BaseLayout title={skill.data.title} description={skill.data.summary}>
  <SiteHeader />
  <main id="content" class="outer">
    <article>
      <header class="canvas pt-10 md:pt-14">
        <p class="meta">
          <span class="meta-accent">{formatStage(skill.data.stage, stages)}</span>
          <span>No. {String(skill.data.order).padStart(2, '0')} of {allSkills.length}</span>
          <span>{readingLabel(skill.body)}</span>
        </p>

        <h1 class="article-title">{skill.data.title}</h1>
        <p class="article-excerpt">{skill.data.summary}</p>

        <div class="mt-8">
          <StageProgress stages={stages} current={skill.data.stage} />
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-border pt-6">
          <h2 class="eyebrow mr-1">Source</h2>
          <a href={sourceUrl} target="_blank" rel="noreferrer" class="link-sweep text-sm">
            {skill.data.sourceFile}
          </a>
        </div>
      </header>

      {
        skill.data.video && (
          <div class="video-frame canvas mt-10">
            <iframe
              src={skill.data.video}
              title={`${skill.data.title} walkthrough`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }

      <div class="prose canvas mt-12">
        <Content />
      </div>

      {
        (previousSkill || nextSkill) && (
          <footer class="canvas mt-16 border-t border-border pt-8">
            <nav class="grid gap-8 sm:grid-cols-2" aria-label="Skill sequence navigation">
              <div>
                {previousSkill && (
                  <a href={`/skills/${previousSkill.slug}/`} class="link-title link-nudge">
                    <span class="eyebrow">
                      <span class="link-nudge__arrow link-nudge__arrow--prev">&larr;</span> Previous
                    </span>
                    <span class="link-title__text mt-2 block font-semibold leading-snug">
                      {previousSkill.data.title}
                    </span>
                  </a>
                )}
              </div>
              <div class="sm:text-right">
                {nextSkill && (
                  <a href={`/skills/${nextSkill.slug}/`} class="link-title link-nudge">
                    <span class="eyebrow">
                      Next <span class="link-nudge__arrow link-nudge__arrow--next">&rarr;</span>
                    </span>
                    <span class="link-title__text mt-2 block font-semibold leading-snug">
                      {nextSkill.data.title}
                    </span>
                  </a>
                )}
              </div>
            </nav>
          </footer>
        )
      }
    </article>

    {
      relatedSkills.length > 0 && (
        <section class="canvas mt-[var(--space-section)]" aria-labelledby="keep-reading">
          <h2 id="keep-reading" class="section-title">
            Related skills
          </h2>
          <div class="grid gap-7">
            {relatedSkills.map((related) => (
              <SkillCard skill={related} variant="compact" headingLevel="h3" stages={stages} />
            ))}
          </div>
        </section>
      )
    }
  </main>
  <SiteFooter />

  <script is:inline>
    document.querySelectorAll('.prose pre').forEach((pre, index) => {
      if (pre.closest('.code-copy-frame')) return;

      const code = pre.querySelector('code');
      const frame = document.createElement('div');
      const button = document.createElement('button');
      const liveRegion = document.createElement('span');
      const labelId = `code-copy-${index}`;

      frame.className = 'code-copy-frame';
      button.type = 'button';
      button.className = 'code-copy-button';
      button.setAttribute('aria-describedby', labelId);
      button.textContent = 'Copy';
      liveRegion.id = labelId;
      liveRegion.className = 'sr-only';
      liveRegion.setAttribute('aria-live', 'polite');

      pre.parentNode?.insertBefore(frame, pre);
      frame.append(pre, button, liveRegion);

      button.addEventListener('click', async () => {
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
          await navigator.clipboard.writeText(code?.textContent ?? pre.textContent ?? '');
          button.textContent = 'Copied';
          liveRegion.textContent = 'Code copied';
        } catch {
          button.textContent = 'Failed';
          liveRegion.textContent = 'Copy failed';
        }
        window.setTimeout(() => {
          button.textContent = 'Copy';
        }, 1800);
      });
    });
  </script>

  <style>
    .article-title {
      margin: 1.25rem 0 0;
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 6.5vw, 4rem);
      font-weight: 600;
      letter-spacing: -0.035em;
      line-height: 1.02;
      text-wrap: balance;
      word-break: break-word;
    }

    .article-excerpt {
      margin: 1.25rem 0 0;
      color: color-mix(in srgb, var(--foreground) 82%, transparent);
      font-size: clamp(1.125rem, 2.4vw, 1.4rem);
      line-height: 1.45;
      text-wrap: pretty;
    }

    .video-frame {
      background: var(--muted);
      border-radius: var(--radius-md);
      padding: 0.5rem;
    }

    .video-frame iframe {
      width: 100%;
      aspect-ratio: 16 / 9;
      border: none;
      display: block;
      border-radius: var(--radius-sm);
    }
  </style>
</BaseLayout>
