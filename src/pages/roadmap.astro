---
import RoadmapTimeline from '../components/RoadmapTimeline.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Roadmap" description="All the stuff coming soon.">
  <SiteHeader />
  <main id="content" class="outer">
    <div class="canvas pagehead">
      <h1 class="pagehead-title">Skills roadmap</h1>
      <p class="pagehead-description">All the stuff coming soon.</p>
    </div>
    <div class="canvas pb-[var(--space-section)]">
      <RoadmapTimeline />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
